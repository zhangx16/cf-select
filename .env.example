TZ=Asia/Shanghai
LAN_BIND_IP=127.0.0.1
WEB_PORT=13335
WEB_USERNAME=
WEB_PASSWORD=
MEMORY_LIMIT=256m
APK_MIRROR=

# Keep disabled until your own domain, token and source library are configured.
DNS_AUTOMATION_ENABLED=false
DNS_NAME=hk.example.com
CF_API_TOKEN=
CF_ZONE_ID=
SOURCE_FILE=/data/source-ipv4.txt
SPEED_TEST_HOST=speed.okl.abrdns.com
INITIALIZE_FROM_ORDERED_LIST=false

LATENCY_LIMIT_MS=65
SPEED_MIN_MBPS=8
LOSS_LIMIT_PERCENT=10
TCP_SAMPLES=10
TCP_TIMEOUT_SECONDS=1
FAILURE_TRIGGER=5
SCREEN_WORKERS=16
QUEUE_TARGET=100
HOURLY_MINUTE=7
# Python weekday: Monday=0 ... Sunday=6.
WEEKLY_WEEKDAY=6
WEEKLY_TIME=03:17
